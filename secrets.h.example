#pragma once
// Copy this file to secrets.h (same folder as the .ino) and set your own
// network name below before building. secrets.h is listed in .gitignore
// so your real value is never committed or pushed.
//
// Note: this is only used by Modes 1 and 2 (the tap-survey and walk-survey
// scans), which look for this specific network's signal while you're
// walking around. Mode 3 (continuous monitor) connects via its own SoftAP
// provisioning flow instead -- enter your Wi-Fi password once on your
// phone via the "ESP SoftAP Prov" app, and it's stored in the ESP32's own
// NVS flash, never in this file or anywhere in source control.

const char* TARGET_SSID = "YourNetworkNameHere";
